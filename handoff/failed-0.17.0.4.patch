+
+bool canAcceptFileDrop(const QUrl &destination)
+{
+    if (!destination.isValid()
+        || sameLocation(destination, kThisPcUrl)
+        || isSearchLocation(destination)) {
+        return false;
+    }
+
+    const QString scheme = destination.scheme().toLower();
+    return scheme != QStringLiteral("remote")
+        && scheme != QStringLiteral("filenamesearch");
+}
+
+QUrl parentUrlForDropSource(const QUrl &sourceRaw)
+{
+    const QUrl source = normalizedUrl(sourceRaw);
+    if (!source.isValid()) {
+        return {};
+    }
+
+    if (source.isLocalFile()) {
+        return QUrl::fromLocalFile(
+            QFileInfo(source.toLocalFile()).absolutePath());
+    }
+
+    QUrl parent = source;
+    QString path = parent.path();
+    while (path.size() > 1 && path.endsWith(QLatin1Char('/'))) {
+        path.chop(1);
+    }
+
+    const int slash = path.lastIndexOf(QLatin1Char('/'));
+    parent.setPath(slash <= 0 ? QStringLiteral("/") : path.left(slash));
+    parent.setQuery(QString());
+    parent.setFragment(QString());
+    return parent;
+}
+
+bool allDropSourcesAlreadyInDestination(
+    const QList<QUrl> &urls,
+    const QUrl &destination)
+{
+    if (urls.isEmpty()) {
+        return false;
+    }
+
+    for (const QUrl &url : urls) {
+        if (!sameLocation(parentUrlForDropSource(url), destination)) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+bool dropWouldCreateCycle(
+    const QList<QUrl> &urls,
+    const QUrl &destination)
+{
+    for (const QUrl &source : urls) {
+        if (sameLocation(source, destination)
+            || isWithinLocation(destination, source)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool dropSourcesShareStorageWithDestination(
+    const QList<QUrl> &urls,
+    const QUrl &destination)
+{
+    const QString destinationPath =
+        localPathForFileOrAdmin(destination);
+    if (destinationPath.isEmpty() || urls.isEmpty()) {
+        return false;
+    }
+
+    QStorageInfo destinationStorage(destinationPath);
+    if (!destinationStorage.isValid()) {
+        return false;
+    }
+
+    for (const QUrl &source : urls) {
+        const QString sourcePath = localPathForFileOrAdmin(source);
+        if (sourcePath.isEmpty()) {
+            return false;
+        }
+
+        QStorageInfo sourceStorage(sourcePath);
+        if (!sourceStorage.isValid()) {
+            return false;
+        }
+
+        const QByteArray sourceDevice = sourceStorage.device();
+        const QByteArray destinationDevice = destinationStorage.device();
+
+        if (!sourceDevice.isEmpty() && !destinationDevice.isEmpty()) {
+            if (sourceDevice != destinationDevice) {
+                return false;
+            }
+        } else if (QDir::cleanPath(sourceStorage.rootPath())
+                   != QDir::cleanPath(destinationStorage.rootPath())) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+Qt::DropAction preferredDropAction(
+    const QList<QUrl> &urls,
+    const QUrl &destination,
+    Qt::KeyboardModifiers modifiers)
+{
+    if (destination.scheme() == QStringLiteral("trash")) {
+        return Qt::MoveAction;
+    }
+
+    if ((modifiers.testFlag(Qt::ControlModifier)
+         && modifiers.testFlag(Qt::ShiftModifier))
+        || modifiers.testFlag(Qt::AltModifier)) {
+        return Qt::LinkAction;
+    }
+
+    if (modifiers.testFlag(Qt::ControlModifier)) {
+        return Qt::CopyAction;
+    }
+
+    if (modifiers.testFlag(Qt::ShiftModifier)) {
+        return Qt::MoveAction;
+    }
+
+    return dropSourcesShareStorageWithDestination(urls, destination)
+        ? Qt::MoveAction
+        : Qt::CopyAction;
+}
+
+QPixmap dragPixmapForItems(
+    const QIcon &icon,
+    int count,
+    const QPalette &palette)
+{
+    QPixmap pixmap(64, 64);
+    pixmap.fill(Qt::transparent);
+
+    QPainter painter(&pixmap);
+    icon.paint(&painter, QRect(4, 12, 44, 44));
+
+    if (count > 1) {
+        const QRect badgeRect(38, 2, 24, 24);
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(palette.highlight());
+        painter.drawEllipse(badgeRect);
+        painter.setPen(palette.highlightedText().color());
+        QFont font = painter.font();
+        font.setBold(true);
+        font.setPointSize(std::max(7, font.pointSize() - 1));
+        painter.setFont(font);
+        painter.drawText(
+            badgeRect,
+            Qt::AlignCenter,
+            count > 99 ? QStringLiteral("99+") : QString::number(count));
+    }
+
+    return pixmap;
+}
