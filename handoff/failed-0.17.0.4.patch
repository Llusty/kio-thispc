+class ExplorerTabBar : public QTabBar
+{
+    Q_OBJECT
+
+public:
+    explicit ExplorerTabBar(QWidget *parent = nullptr)
+        : QTabBar(parent)
+    {
+        setAcceptDrops(true);
+        m_hoverTimer = new QTimer(this);
+        m_hoverTimer->setSingleShot(true);
+        m_hoverTimer->setInterval(650);
+        connect(
+            m_hoverTimer,
+            &QTimer::timeout,
+            this,
+            [this] {
+                if (m_hoverTab >= 0 && m_hoverTab < count()) {
+                    setCurrentIndex(m_hoverTab);
+                }
+            });
+    }
+
+Q_SIGNALS:
+    void urlsDropped(
+        const QList<QUrl> &urls,
+        int tabIndex,
+        Qt::KeyboardModifiers modifiers);
+
+protected:
+    void dragEnterEvent(QDragEnterEvent *event) override
+    {
+        if (!event->mimeData()->hasUrls()) {
+            QTabBar::dragEnterEvent(event);
+            return;
+        }
+        event->acceptProposedAction();
+    }
+
+    void dragMoveEvent(QDragMoveEvent *event) override
+    {
+        if (!event->mimeData()->hasUrls()) {
+            QTabBar::dragMoveEvent(event);
+            return;
+        }
+
+        const int index = tabAt(event->position().toPoint());
+        if (index < 0) {
+            clearHoverTab();
+            event->ignore();
+            return;
+        }
+
+        if (m_hoverTab != index) {
+            m_hoverTab = index;
+            m_hoverTimer->start();
+        }
+
+        event->acceptProposedAction();
+    }
+
+    void dragLeaveEvent(QDragLeaveEvent *event) override
+    {
+        clearHoverTab();
+        event->accept();
+    }
+
+    void dropEvent(QDropEvent *event) override
+    {
+        const int index = tabAt(event->position().toPoint());
+        clearHoverTab();
+
+        if (!event->mimeData()->hasUrls() || index < 0) {
+            event->ignore();
+            return;
+        }
+
+        Q_EMIT urlsDropped(
+            event->mimeData()->urls(),
+            index,
+            event->modifiers());
+        event->acceptProposedAction();
+    }
+
+private:
+    void clearHoverTab()
+    {
+        m_hoverTab = -1;
+        if (m_hoverTimer) {
+            m_hoverTimer->stop();
+        }
+    }
+
+    QTimer *m_hoverTimer = nullptr;
+    int m_hoverTab = -1;
 };
 
 
